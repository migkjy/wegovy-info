# ── 사이트 URL ────────────────────────────────────────────────────
# NUC 로컬 배포: cloudflared 터널을 통해 외부 접근
NEXT_PUBLIC_SITE_URL=https://wegovy.newbizsoft.com

# ── Cloudflare Tunnel (NUC → 외부 접근용) ──────────────────────────
# Cloudflare Zero Trust 대시보드에서 생성한 터널 토큰
# 실행: cloudflared tunnel --no-autoupdate run --token $WEGOVY_TUNNEL_TOKEN
WEGOVY_TUNNEL_TOKEN=your-tunnel-token

# ── Turso DB (required for newsletter, community, pipeline) ──────
TURSO_DB_URL=libsql://your-db-name-username.region.turso.io
TURSO_DB_TOKEN=your-turso-token

# ── Google Analytics 4 (production only, optional) ───────────────
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ── Google Search Console 인증 (optional) ────────────────────────
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your-verification-code

# ── Cloudflare Turnstile (community spam protection) ─────────────
# Get keys from: https://dash.cloudflare.com/turnstile
# Use test keys for local development:
#   Site key:   1x00000000000000000000AA
#   Secret key: 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key
TURNSTILE_SECRET_KEY=your-turnstile-secret-key

# ── Newsletter (optional, for Resend.com integration) ────────────
# Get API key from: https://resend.com
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Google AdSense (optional, add after approval) ───────────────
NEXT_PUBLIC_ADSENSE_ID=ca-pub-XXXXXXXXXX
